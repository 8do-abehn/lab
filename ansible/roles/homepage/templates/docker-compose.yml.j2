---
# Homepage dashboard, managed by Ansible, do not edit manually

services:
  homepage:
    image: {{ homepage_image }}
    container_name: homepage
    ports:
      - "127.0.0.1:{{ homepage_port }}:3000"
    volumes:
      - {{ homepage_dir }}/config:/app/config
    environment:
      # tailscale serve passes the browser's Host header through. Loopback is
      # listed too for the role's own health check.
      HOMEPAGE_ALLOWED_HOSTS: "{{ homepage_hostname }},127.0.0.1:{{ homepage_port }}"
    dns:
{% for server in homepage_dns %}
      - {{ server }}
{% endfor %}
    restart: unless-stopped

  # Serves the reshaped weather files (weather-fetch-*.timer) to the weather
  # tiles as http://weather:8080/<name>.json. No published port: only
  # containers on this compose network can reach it.
  weather:
    image: {{ homepage_weather_image }}
    container_name: homepage-weather
    command: ["httpd", "-f", "-p", "8080", "-h", "/www"]
    user: "65534:65534"
    volumes:
      - {{ homepage_weather_dir }}:/www:ro
    restart: unless-stopped
