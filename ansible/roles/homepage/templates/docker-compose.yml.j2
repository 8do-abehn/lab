---
# Homepage dashboard, managed by Ansible, do not edit manually

services:
  homepage:
    image: {{ homepage_image }}
    container_name: homepage
    ports:
      - "127.0.0.1:{{ homepage_port }}:3000"
    volumes:
      - {{ homepage_dir }}/config:/app/config
    environment:
      # tailscale serve passes the browser's Host header through. Loopback is
      # listed too for the role's own health check.
      HOMEPAGE_ALLOWED_HOSTS: "{{ homepage_hostname }},127.0.0.1:{{ homepage_port }}"
    dns:
{% for server in homepage_dns %}
      - {{ server }}
{% endfor %}
    restart: unless-stopped
