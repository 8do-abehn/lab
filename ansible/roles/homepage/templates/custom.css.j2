/* Managed by Ansible (roles/homepage), do not edit manually */

/* Floating chat (templates/custom.js.j2). Colors come from Homepage's theme
   variables, so the panel follows the dashboard's color setting. */
#lab-chat-toggle {
  position: fixed;
  right: 1.5rem;
  bottom: 1.5rem;
  z-index: 50;
  width: 3.5rem;
  height: 3.5rem;
  display: grid;
  place-items: center;
  border-radius: 9999px;
  color: rgb(var(--color-100));
  background: rgb(var(--color-700));
  box-shadow: 0 6px 20px rgb(0 0 0 / 0.35);
  cursor: pointer;
  transition: transform 0.15s ease, background 0.15s ease;
}
#lab-chat-toggle:hover {
  background: rgb(var(--color-600));
  transform: scale(1.06);
}

#lab-chat-panel {
  position: fixed;
  top: 1rem;
  right: 1rem;
  bottom: 5.75rem;
  z-index: 50;
  width: min(30rem, calc(100vw - 2rem));
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 0.75rem;
  background: rgb(var(--color-900));
  border: 1px solid rgb(var(--color-700));
  box-shadow: 0 12px 40px rgb(0 0 0 / 0.45);
  /* Closed: slid off to the right and out of the tab order. */
  transform: translateX(calc(100% + 2rem));
  visibility: hidden;
  transition: transform 0.2s ease, visibility 0s linear 0.2s;
}
#lab-chat-panel.open {
  transform: none;
  visibility: visible;
  transition: transform 0.2s ease;
}
#lab-chat-panel header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  color: rgb(var(--color-200));
  background: rgb(var(--color-800));
  font-size: 0.875rem;
}
#lab-chat-panel header span {
  flex: 1;
}
#lab-chat-panel header a,
#lab-chat-panel header button {
  display: grid;
  place-items: center;
  padding: 0.25rem;
  border-radius: 0.375rem;
  color: inherit;
  cursor: pointer;
}
#lab-chat-panel header a:hover,
#lab-chat-panel header button:hover {
  background: rgb(var(--color-700));
}
#lab-chat-panel iframe {
  flex: 1;
  width: 100%;
  border: 0;
}
