---
# mem0 stack — managed by Ansible, do not edit manually

services:
  ollama:
    image: {{ mem0_ollama_image }}
    container_name: mem0-ollama
    ports:
      - "{{ mem0_ollama_port }}:11434"
    volumes:
      - ollama_data:/root/.ollama
    restart: unless-stopped

  openmemory:
    image: openmemory:latest
    pull_policy: never
    container_name: mem0-openmemory
    ports:
      - "{{ mem0_openmemory_port }}:8080"
    environment:
      - OM_PORT=8080
      - OM_MODE=standard
      - OM_TIER=hybrid
      - OM_DB_PATH=/data/openmemory.sqlite
      - OM_METADATA_BACKEND=sqlite
      - OM_VECTOR_BACKEND=sqlite
      - OM_EMBEDDINGS=ollama
      - OM_EMBEDDING_FALLBACK=synthetic
      - OM_EMBED_MODE=simple
      - OM_VEC_DIM=256
      - OLLAMA_URL=http://ollama:11434
      - OM_OLLAMA_URL=http://ollama:11434
      - OM_DECAY_REINFORCE_ON_QUERY=true
      - OM_REGENERATION_ENABLED=true
      - OM_LG_REFLECTIVE=true
    volumes:
      - openmemory_data:/data
    depends_on:
      - ollama
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    restart: unless-stopped

{% if mem0_openwebui_enabled %}
  open-webui:
    image: {{ mem0_openwebui_image }}
    container_name: mem0-openwebui
    ports:
      - "{{ mem0_openwebui_port }}:8080"
    volumes:
      - openwebui_data:/app/backend/data
    environment:
      - OLLAMA_BASE_URL=http://ollama:11434
    depends_on:
      - ollama
    restart: unless-stopped
{% endif %}

volumes:
  ollama_data:
  openmemory_data:
{% if mem0_openwebui_enabled %}
  openwebui_data:
{% endif %}
