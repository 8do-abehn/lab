#!/bin/bash
set -euo pipefail

# Cron's default PATH omits /usr/local/bin, where pipx symlinks apprise.
# Without this, `command -v apprise` silently fails and notifications never fire.
export PATH="/usr/local/bin:$PATH"

# Restic repository prune - managed by Ansible
# Reclaims space for the WHOLE shared repo, not just this host's snapshots.
# Runs weekly on one designated client because prune holds an exclusive repo lock
# for its entire duration; running it nightly on every client serialises the fleet
# behind it and is the likely source of the stale locks in #429.

LOGFILE="{{ backup_log_path }}"
RESTIC_REPOSITORY="sftp:{{ backup_server_user }}@{{ backup_server_host }}:{{ backup_server_repo_path }}"
RESTIC_PASSWORD_FILE="{{ backup_password_file }}"

export RESTIC_REPOSITORY
export RESTIC_PASSWORD_FILE

{% if backup_bandwidth_limit | default('') %}
# Throttle transfer so a long run does not saturate the link at the far end.
# pi-burg sits on a domestic connection offsite, and an unthrottled seed would
# take most of that household's bandwidth for the better part of a day (#478).
RESTIC_LIMITS=(--limit-upload {{ backup_bandwidth_limit }} --limit-download {{ backup_bandwidth_limit }})
{% else %}
RESTIC_LIMITS=()
{% endif %}

{% if backup_notify_enabled | default(false) %}
# Apprise URLs are read from /etc/apprise.yml (mode 0600). The script itself
# is world-readable, so the credential must not live here.
notify() {
    local title="$1"
    local body="$2"
    if [ -r /etc/apprise.yml ] && command -v apprise &>/dev/null; then
        apprise -t "$title" --body "$body" --config /etc/apprise.yml 2>/dev/null || true
    fi
}
{% endif %}

log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOGFILE"
}

# A killed prune leaves a lock that blocks every client's backup, so log loudly
# rather than dying silently.
trap 'log_message "Prune interrupted - its repo lock stays until a later run clears it as stale"; exit 130' INT TERM

{% include '_restic_lock.sh.j2' %}

{% include '_restic_unlock.sh.j2' %}

log_message "Starting restic prune"
PRUNE_START=$(date +%s)

if ! ping -c 1 -W 5 {{ backup_server_host }} > /dev/null 2>&1; then
    log_message "ERROR: Backup server {{ backup_server_host }} is not reachable"
{% if backup_notify_enabled | default(false) %}
    notify "Restic prune FAILED on $(hostname)" "Server {{ backup_server_host }} unreachable at $(date)"
{% endif %}
    exit 1
fi

clear_stale_locks "prune"

run_restic_locked prune "${RESTIC_LIMITS[@]}" {{ backup_retry_lock_flag }}
PRUNE_RC="$RESTIC_RC"

PRUNE_END=$(date +%s)
DURATION=$(( PRUNE_END - PRUNE_START ))
DURATION_MIN=$(( DURATION / 60 ))
DURATION_SEC=$(( DURATION % 60 ))

if [ "$PRUNE_RC" -eq 0 ]; then
    log_message "Prune completed successfully in ${DURATION_MIN}m ${DURATION_SEC}s"
{% if backup_notify_enabled | default(false) %}
    # Duration is the number worth watching: it grows with repo size, and a prune
    # that starts overrunning its window is the early warning for lock contention.
    notify "Restic prune OK on $(hostname)" "$(cat <<NOTIFY
Completed at $(date)

Duration: ${DURATION_MIN}m ${DURATION_SEC}s
$(echo "$RESTIC_OUTPUT" | tail -3)
NOTIFY
)"
{% endif %}
elif [ "$PRUNE_RC" -eq 11 ]; then
    # Another host held a live lock for the whole --retry-lock wait. Nothing
    # is wrong with the repo; space just is not reclaimed until next week.
    log_message "Prune BLOCKED by a repo lock after ${DURATION_MIN}m ${DURATION_SEC}s"
{% if backup_notify_enabled | default(false) %}
    notify "Restic prune BLOCKED on $(hostname)" "restic prune could not get the repo lock within {{ backup_lock_wait }} at $(date). The repo is fine; space will be reclaimed on the next weekly run. Holder:
$(echo "$RESTIC_OUTPUT" | tail -5)"
{% endif %}
    exit "$PRUNE_RC"
else
    log_message "Prune FAILED with exit code $PRUNE_RC after ${DURATION_MIN}m ${DURATION_SEC}s"
{% if backup_notify_enabled | default(false) %}
    notify "Restic prune FAILED on $(hostname)" "restic prune exited with code $PRUNE_RC at $(date) after ${DURATION_MIN}m ${DURATION_SEC}s.
$(echo "$RESTIC_OUTPUT" | tail -5)"
{% endif %}
    exit "$PRUNE_RC"
fi
