#!/bin/bash
set -euo pipefail

# Cron's default PATH omits /usr/local/bin, where pipx symlinks apprise.
# Without this, `command -v apprise` silently fails and notifications never fire.
export PATH="/usr/local/bin:$PATH"

# Restic backup script - managed by Ansible
# Backs up to Pi backup server over Tailscale

LOGFILE="{{ backup_log_path }}"
RESTIC_REPOSITORY="sftp:{{ backup_server_user }}@{{ backup_server_host }}:{{ backup_server_repo_path }}"
RESTIC_PASSWORD_FILE="{{ backup_password_file }}"

export RESTIC_REPOSITORY
export RESTIC_PASSWORD_FILE

{% if backup_bandwidth_limit | default('') %}
# Throttle transfer so a long run does not saturate the link at the far end.
# pi-burg sits on a domestic connection offsite, and an unthrottled seed would
# take most of that household's bandwidth for the better part of a day (#478).
RESTIC_LIMITS=(--limit-upload {{ backup_bandwidth_limit }} --limit-download {{ backup_bandwidth_limit }})
{% else %}
RESTIC_LIMITS=()
{% endif %}

{% if backup_notify_enabled | default(false) %}
# Apprise URLs are read from /etc/apprise.yml (mode 0600). The script itself
# is world-readable, so the credential must not live here.
notify() {
    local title="$1"
    local body="$2"
    if [ -r /etc/apprise.yml ] && command -v apprise &>/dev/null; then
        apprise -t "$title" --body "$body" --config /etc/apprise.yml 2>/dev/null || true
    fi
}
{% endif %}

# Function to log messages with timestamp
log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOGFILE"
}

# Trap Ctrl+C or TERM and log
trap 'log_message "Backup interrupted"; exit 130' INT TERM

{% include '_restic_lock.sh.j2' %}

{% include '_restic_unlock.sh.j2' %}

log_message "Starting restic backup"
{% if backup_notify_enabled | default(false) %}
BACKUP_START=$(date +%s)
{% endif %}

# Check if backup server is reachable
if ! ping -c 1 -W 5 {{ backup_server_host }} > /dev/null 2>&1; then
    log_message "ERROR: Backup server {{ backup_server_host }} is not reachable"
{% if backup_notify_enabled | default(false) %}
    notify "Backup FAILED on $(hostname)" "Server {{ backup_server_host }} unreachable at $(date)"
{% endif %}
    exit 1
fi

{% if backup_required_mounts | default([]) | length > 0 %}
# Verify network filesystems are actually mounted before backing up.
# A failed mount leaves an empty directory behind, and restic will snapshot
# that quite happily and report success. jellyfin01 lost 3 days of useful
# snapshots this way when its CephFS mount failed at boot.
{% for mount in backup_required_mounts %}
if ! mountpoint -q "{{ mount }}"; then
    log_message "ERROR: {{ mount }} is not a mountpoint - aborting before restic runs"
{% if backup_notify_enabled | default(false) %}
    notify "Backup ABORTED on $(hostname)" "{{ mount }} is not mounted at $(date). Refusing to snapshot an empty directory. Fix the mount, then re-run {{ backup_script_path }}."
{% endif %}
    exit 1
fi

# Mounted but empty means the filesystem is there and the data is not.
if [ -z "$(ls -A "{{ mount }}" 2>/dev/null)" ]; then
    log_message "ERROR: {{ mount }} is mounted but empty - aborting before restic runs"
{% if backup_notify_enabled | default(false) %}
    notify "Backup ABORTED on $(hostname)" "{{ mount }} is mounted but empty at $(date). Refusing to snapshot it. Check the filesystem before re-running {{ backup_script_path }}."
{% endif %}
    exit 1
fi

log_message "Verified mount: {{ mount }}"
{% endfor %}

{% endif %}
# Before the snapshot as well as before retention: a stale EXCLUSIVE lock
# (a forget or prune that died) blocks backups too, not just retention.
clear_stale_locks "backup"

# Run backup
log_message "Backing up: {{ backup_paths | join(', ') }}"
BACKUP_STDERR=$(mktemp)
BACKUP_OUTPUT=$(restic backup "${RESTIC_LIMITS[@]}" {{ backup_retry_lock_flag }} \
{% for path in backup_paths %}
    "{{ path }}" \
{% endfor %}
{% for exclude in backup_excludes %}
    --exclude "{{ exclude }}" \
{% endfor %}
    --json 2>"$BACKUP_STDERR") && BACKUP_RC=0 || BACKUP_RC=$?
echo "$BACKUP_OUTPUT" >> "$LOGFILE"

if [ "$BACKUP_RC" -eq 0 ]; then
    log_message "Backup completed successfully"
    # Parse stats from JSON summary line
    SUMMARY=$(echo "$BACKUP_OUTPUT" | grep '"message_type":"summary"' || true)
    if [ -n "$SUMMARY" ]; then
        FILES_NEW=$(echo "$SUMMARY" | sed -n 's/.*"files_new":\([0-9]*\).*/\1/p')
        FILES_CHANGED=$(echo "$SUMMARY" | sed -n 's/.*"files_changed":\([0-9]*\).*/\1/p')
        FILES_UNMODIFIED=$(echo "$SUMMARY" | sed -n 's/.*"files_unmodified":\([0-9]*\).*/\1/p')
        BYTES_ADDED=$(echo "$SUMMARY" | sed -n 's/.*"data_added":\([0-9]*\).*/\1/p')
        DATA_ADDED=$(numfmt --to=iec --suffix=B "${BYTES_ADDED:-0}" 2>/dev/null || echo "${BYTES_ADDED:-0} bytes")
    fi
else
    BACKUP_ERROR=$(tail -5 "$BACKUP_STDERR")
    log_message "Backup failed with exit code $BACKUP_RC"
    log_message "Error: $BACKUP_ERROR"
{% if backup_notify_enabled | default(false) %}
    notify "Backup FAILED on $(hostname)" "restic backup exited with code $BACKUP_RC at $(date)
Error: $BACKUP_ERROR"
{% endif %}
    rm -f "$BACKUP_STDERR"
    exit "$BACKUP_RC"
fi
rm -f "$BACKUP_STDERR"

# Run retention policy. Dropping snapshot references is metadata-only and cheap;
# reclaiming the space is not. --prune walks the whole repo under an exclusive
# lock, so it is opt-in here and normally left to the weekly job on the designated
# prune host instead of running on every client every night.
log_message "Applying retention policy"
clear_stale_locks "retention"
run_restic_locked forget "${RESTIC_LIMITS[@]}" {{ backup_retry_lock_flag }} \
    --keep-daily {{ backup_keep_daily }} \
    --keep-weekly {{ backup_keep_weekly }} \
{% if backup_prune_inline | default(false) %}
    --prune \
{% endif %}
    --keep-monthly {{ backup_keep_monthly }}

# Consecutive nights retention has been lock-blocked. Kept outside /run so a
# reboot does not reset the count and hide a lock that keeps coming back.
RETENTION_BLOCKED_FILE="{{ backup_state_dir }}/retention-blocked-nights"
mkdir -p "{{ backup_state_dir }}"
RETENTION_BLOCKED_NIGHTS=0

if [ "$RESTIC_RC" -eq 0 ]; then
    log_message "Retention policy applied successfully"
    rm -f "$RETENTION_BLOCKED_FILE"
elif [ "$RESTIC_RC" -eq 11 ]; then
    # Tonight's snapshot is safe; only the cleanup of old ones waited out
    # --retry-lock behind another host's live lock. forget catches up on the
    # next run that gets the lock, so one blocked night costs one extra day
    # of snapshots, not data. Only a lock that keeps winning needs a human.
    RETENTION_BLOCKED_NIGHTS=$(cat "$RETENTION_BLOCKED_FILE" 2>/dev/null || echo 0)
    case "$RETENTION_BLOCKED_NIGHTS" in
        ''|*[!0-9]*) RETENTION_BLOCKED_NIGHTS=0 ;;
    esac
    RETENTION_BLOCKED_NIGHTS=$(( RETENTION_BLOCKED_NIGHTS + 1 ))
    echo "$RETENTION_BLOCKED_NIGHTS" > "$RETENTION_BLOCKED_FILE"
{% if backup_notify_enabled | default(false) %}
    RETENTION_LOCK_INFO=$(echo "$RESTIC_OUTPUT" | tail -5)
{% endif %}
    log_message "Retention BLOCKED by a repo lock (${RETENTION_BLOCKED_NIGHTS} consecutive night(s)); snapshot is OK"
else
    log_message "Retention policy failed with exit code $RESTIC_RC"
{% if backup_notify_enabled | default(false) %}
    notify "Backup FAILED on $(hostname)" "Retention policy failed with code $RESTIC_RC at $(date)
Error: $(echo "$RESTIC_OUTPUT" | tail -5)"
{% endif %}
    exit "$RESTIC_RC"
fi

log_message "Backup process finished"
{% if backup_notify_enabled | default(false) %}
BACKUP_END=$(date +%s)
DURATION=$(( BACKUP_END - BACKUP_START ))
DURATION_MIN=$(( DURATION / 60 ))
DURATION_SEC=$(( DURATION % 60 ))
SNAPSHOT_COUNT=$(restic snapshots --json 2>/dev/null | grep -c '"short_id"' || echo "?")

NOTIFY_TITLE="Backup OK on $(hostname)"
RETENTION_LINE="Retention: applied"
if [ "$RETENTION_BLOCKED_NIGHTS" -ge {{ backup_retention_blocked_alert_after }} ]; then
    NOTIFY_TITLE="Retention BLOCKED on $(hostname)"
    RETENTION_LINE="Retention: BLOCKED by a repo lock for ${RETENTION_BLOCKED_NIGHTS} consecutive nights. Snapshots are still being taken, but old ones are not being expired. Holder:
${RETENTION_LOCK_INFO}"
elif [ "$RETENTION_BLOCKED_NIGHTS" -gt 0 ]; then
    RETENTION_LINE="Retention: skipped, repo locked by another job (night ${RETENTION_BLOCKED_NIGHTS}; alerts after {{ backup_retention_blocked_alert_after }})"
fi

notify "$NOTIFY_TITLE" "$(cat <<NOTIFY
Completed at $(date)

Files: ${FILES_NEW:-0} new, ${FILES_CHANGED:-0} changed, ${FILES_UNMODIFIED:-0} unmodified
Data added: ${DATA_ADDED:-n/a}
Duration: ${DURATION_MIN}m ${DURATION_SEC}s
Snapshots: ${SNAPSHOT_COUNT}
${RETENTION_LINE}
NOTIFY
)"
{% endif %}

# Non-zero only once the block needs attention, so a single expected overlap
# with a long run elsewhere does not look like a failed backup.
if [ "$RETENTION_BLOCKED_NIGHTS" -ge {{ backup_retention_blocked_alert_after }} ]; then
    exit 11
fi
