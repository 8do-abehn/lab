# {{ ansible_managed }}
# Upstream's contrib/systemd/asterisk.service with Type=simple instead of
# notify: this build has no libsystemd, so Asterisk never reports READY.
[Unit]
Description=Asterisk PBX and telephony daemon.
After=network.target

[Service]
Type=simple
Environment=HOME=/var/lib/asterisk
WorkingDirectory=/var/lib/asterisk
User=asterisk
Group=asterisk
ExecStart=/usr/sbin/asterisk -mqf -C /etc/asterisk/asterisk.conf
ExecReload=/usr/sbin/asterisk -rx 'core reload'
LimitCORE=infinity
Restart=always
RestartSec=4
StandardOutput=null
PrivateTmp=true
RuntimeDirectory=asterisk

[Install]
WantedBy=multi-user.target
