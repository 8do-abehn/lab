#!/bin/bash
# CephFS mount watchdog - managed by Ansible. See #456.
#
# Recovers {{ cephfs_client_mount_path }} from the ways it has actually
# broken, which need different detection:
#
#   2026-09-06  The container booted before the Ceph MDS was ready. ceph-fuse
#               failed once, systemd .mount units have no Restart=, and nothing
#               retried. Offline 2 days. Detected by: not a mountpoint.
#
#   2026-09-10  ceph-fuse was OOM-killed inside the container, leaving a stale
#               FUSE mount. Offline 27 hours. NOT detected by mountpoint -q,
#               which still returns true; the mount only fails on I/O.
#
#   2026-10-04  ceph-fuse hung on readdir and then exited, leaving the mount
#               "Transport endpoint is not connected". Offline 8 hours, and
#               this script mailed every 5 minutes without fixing it: on a
#               dead FUSE mount mountpoint -q FAILS (it cannot stat the path),
#               so the stale-mount branch was skipped, systemd still showed the
#               unit active, and "systemctl start" was a no-op.
#
# Hence the health check is an actual read, and "is something mounted here"
# comes from the kernel's mount table, never from stat-ing the path.
set -uo pipefail

# Cron's PATH omits /usr/local/bin, where pipx puts apprise.
export PATH="/usr/local/bin:$PATH"

MOUNT_PATH="{{ cephfs_client_mount_path }}"
MOUNT_UNIT="{{ cephfs_client_mount_unit }}"
LOGFILE="{{ cephfs_client_watchdog_log }}"
PROBE_TIMEOUT={{ cephfs_client_watchdog_probe_timeout }}
# While the mount stays down, re-alert at most this often (seconds). The first
# failure and the recovery always alert; everything in between is log-only, so
# an overnight outage is a handful of messages instead of one every probe.
ALERT_REPEAT={{ cephfs_client_watchdog_alert_repeat }}
# Outage bookkeeping. /run is tmpfs, so a reboot starts clean, which is fine:
# a reboot is itself a fresh attempt and a still-broken mount re-alerts.
STATE_FILE="/run/cephfs-watchdog.state"
DIAG_DIR="{{ cephfs_client_diag_dir }}"
DIAG_KEEP={{ cephfs_client_diag_keep }}
ASOK_TOOL="{{ cephfs_client_asok_tool }}"
CLIENT_LOG_DIR="{{ cephfs_client_log_dir }}"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOGFILE"; }

notify() {
    [ -r /etc/apprise.yml ] || return 0
    command -v apprise >/dev/null 2>&1 || return 0
    apprise -t "$1" --body "$2" --config /etc/apprise.yml >/dev/null 2>&1 || true
}

# Healthy means readable, not merely mounted. A stale FUSE mount can pass
# mountpoint -q and then block or error on the first read, so the read is
# wrapped in a timeout: without it this script would hang exactly when the
# mount is broken, which is when it most needs to run.
healthy() {
    mountpoint -q "$MOUNT_PATH" || return 1
    timeout "$PROBE_TIMEOUT" ls -A "$MOUNT_PATH" >/dev/null 2>&1 || return 1
    return 0
}

# True if the kernel still has a mount at MOUNT_PATH, dead or alive. Reads
# /proc/self/mounts instead of stat-ing the path, which is what fails with
# ENOTCONN on a dead FUSE mount.
in_mount_table() {
    awk -v p="$MOUNT_PATH" '$2 == p { found = 1 } END { exit !found }' /proc/self/mounts
}

# Snapshot the hung client before recovery destroys the evidence (#579).
# Three MDS evictions in eleven days left nothing on the client side to explain
# them. Everything here is best effort and bounded: a wedged ceph-fuse may not
# answer its admin socket at all, and that silence is itself worth recording.
capture_diagnostics() {
    local dir pid asok cmd
    dir="$DIAG_DIR/$(date '+%Y%m%d-%H%M%S')"
    mkdir -p "$dir" || return 0
    grep " $MOUNT_PATH " /proc/self/mounts > "$dir/mounts.txt" 2>&1

    for pid in $(pgrep -x ceph-fuse); do
        # Thread states and wait channels. /proc/<pid>/stack is denied inside
        # the LXC, so wchan is the closest view of where each thread is stuck.
        ps -L -o tid,stat,wchan:32,comm -p "$pid" > "$dir/threads-$pid.txt" 2>&1
        cp "/proc/$pid/status" "$dir/status-$pid.txt" 2>/dev/null

        # Sockets are named by pid; older ones from dead processes linger.
        for asok in /var/run/ceph/ceph-client.*."$pid".*.asok; do
            [ -S "$asok" ] || continue
            # "log dump" first, so the in-memory debug ring is written to the
            # client log before these queries add their own entries to it.
            for cmd in "log dump" status mds_sessions mds_requests objecter_requests; do
                timeout 15 "$ASOK_TOOL" "$asok" "$cmd" > "$dir/asok-$pid-${cmd// /_}.txt" 2>&1 \
                    || echo "no answer from admin socket (exit $?)" >> "$dir/asok-$pid-${cmd// /_}.txt"
            done
        done
    done

    # The dumped ring lands at the end of the client log, so keep its tail.
    for f in "$CLIENT_LOG_DIR"/*.log; do
        [ -f "$f" ] && tail -n 20000 "$f" > "$dir/$(basename "$f").tail" 2>/dev/null
    done

    log "diagnostics saved to $dir"
    # Keep only the newest DIAG_KEEP snapshots.
    ls -1d "$DIAG_DIR"/*/ 2>/dev/null | head -n -"$DIAG_KEEP" | xargs -r rm -rf
}

# State file holds "<outage start epoch> <last alert epoch>".
outage_start() { [ -f "$STATE_FILE" ] && awk '{print $1}' "$STATE_FILE"; }

if healthy; then
    # Recovered by something other than this script (a manual remount, or a
    # transient blip): close out the outage so the next one alerts afresh.
    if [ -f "$STATE_FILE" ]; then
        start=$(outage_start)
        mins=$(( ($(date +%s) - start) / 60 ))
        rm -f "$STATE_FILE"
        log "RECOVERED: $MOUNT_PATH is readable again (outage ${mins}m)"
        notify "CephFS mount recovered on $(hostname)" "$MOUNT_PATH is readable again after about ${mins} minutes down."
    fi
    exit 0
fi

log "UNHEALTHY: $MOUNT_PATH failed its read probe, attempting recovery"

# Only on the first failed probe of an outage: that is when the hung process
# is still there to inspect. Later probes in the same outage would only
# capture the failed remount attempts.
[ -f "$STATE_FILE" ] || capture_diagnostics

# A stale mount must be cleared before remounting, or the new mount lands on
# top of a broken one. Lazy unmount is the fallback: a hung FUSE mount will
# refuse a normal umount because processes still hold references to it.
if in_mount_table; then
    log "clearing stale mount"
    umount "$MOUNT_PATH" 2>/dev/null || umount -l "$MOUNT_PATH" 2>/dev/null || true
fi

# Stop the unit explicitly so systemd's view matches the kernel's. Without
# this, a unit systemd still believes is active makes the start below a no-op.
systemctl stop "$MOUNT_UNIT" 2>/dev/null || true

# Essential: a unit left in failed state refuses to start again. This is
# precisely why the 2026-09-06 failure persisted for two days rather than
# being fixed by the next boot or any later trigger.
systemctl reset-failed "$MOUNT_UNIT" 2>/dev/null || true

log "starting $MOUNT_UNIT"
systemctl start "$MOUNT_UNIT" 2>&1 | tee -a "$LOGFILE"
sleep 5

now=$(date +%s)
if healthy; then
    if [ -f "$STATE_FILE" ]; then
        mins=$(( (now - $(outage_start)) / 60 ))
        rm -f "$STATE_FILE"
        log "RECOVERED: $MOUNT_PATH is readable again after remount (outage ${mins}m)"
        notify "CephFS mount recovered on $(hostname)" "$MOUNT_PATH was down for about ${mins} minutes and is readable again after a remount."
    else
        log "RECOVERED: $MOUNT_PATH is readable again"
        notify "CephFS mount recovered on $(hostname)" "$MOUNT_PATH failed its health probe at $(date) and was remounted successfully. Worth checking why: a boot race, ceph-fuse being OOM-killed, or ceph-fuse hanging look different in the journal."
    fi
    exit 0
fi

log "FAILED: $MOUNT_PATH still unreadable after remount"
if [ ! -f "$STATE_FILE" ]; then
    echo "$now $now" > "$STATE_FILE"
    notify "CephFS mount DOWN on $(hostname)" "$MOUNT_PATH failed its health probe at $(date) and could NOT be remounted. Anything reading it is broken until this is fixed. Check Ceph health and the MDS first. Further alerts are suppressed for $((ALERT_REPEAT / 3600))h unless it recovers."
else
    read -r start last < "$STATE_FILE"
    if (( now - last >= ALERT_REPEAT )); then
        echo "$start $now" > "$STATE_FILE"
        notify "CephFS mount STILL DOWN on $(hostname)" "$MOUNT_PATH has been down for $(( (now - start) / 60 )) minutes and every remount attempt has failed."
    fi
fi
exit 1
