---
# Ansible-lint configuration
# See https://ansible-lint.readthedocs.io/

# Exclude archived playbooks and temporary files
exclude_paths:
  - archive/
  - .ansible/
  - '*.retry'

# Skip specific rules for now (fix in future PR)
skip_list:
  - fqcn[action-core]  # TODO: Convert to FQCN in future
  - var-naming[no-role-prefix]  # TODO: Rename variables with role prefix
  - no-changed-when  # We have some command tasks that are intentionally not idempotent checks
  - risky-shell-pipe  # We use pipes in shell commands carefully
  - risky-file-permissions  # TODO: Add explicit permissions
  - command-instead-of-module  # We use curl for GPG key to avoid issues
  - internal-error  # Expected - vault files need password

# Enforce best practices
warn_list:
  - experimental  # Warn on experimental features
  - role-name  # Ensure role names follow conventions

# Use ansible-core for syntax checking
offline: false

# Treat warnings as failures in CI
strict: false  # Set to true if you want to fail on warnings
