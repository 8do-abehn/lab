---
# Ansible-lint configuration
# See https://ansible-lint.readthedocs.io/

# Exclude archived playbooks and temporary files
exclude_paths:
  - archive/
  - .ansible/
  - "*.retry"

skip_list:
  # Reviewed in #411 and kept. About 100 role defaults lack the role prefix,
  # and 20 of them are set from inventory or group_vars. A missed rename there
  # does not error: the role silently falls back to its default (for example
  # ups_server_ip or backup_paths), which is a real outage risk for a small
  # gain. Rename one role at a time when that role is being changed anyway.
  - var-naming[no-role-prefix]
  # Reviewed in #411 and kept. Playbooks load vault.yml through vars_files, so
  # the syntax-check step needs the vault password; without it every playbook
  # that loads the vault reports internal-error. Skipping it keeps local and
  # agent runs usable without unlocking Bitwarden. The gap it leaves is
  # covered in CI by the "Syntax Check" job in ansible-ci.yml, which has the
  # vault password and syntax-checks every playbook.
  - internal-error

# command-instead-of-module is enforced. The few intentional shell-outs carry
# an inline "# noqa: command-instead-of-module" with the reason above them.

# Enforce best practices
warn_list:
  - experimental  # Warn on experimental features
  - role-name  # Ensure role names follow conventions

# Use ansible-core for syntax checking
offline: false

# Warnings fail the run too, so nothing on the warn_list can pile up unseen.
strict: true
